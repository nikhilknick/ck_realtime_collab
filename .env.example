# Production Environment Variables
# Copy this file to .env and fill in your actual values. Never commit .env.

# =========================================
# Frontend (Vite) - Supabase Configuration
# =========================================

# Supabase Project URL (get from Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe to use in frontend, respects RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =========================================
# Frontend (Vite) - CKEditor Configuration
# =========================================

# Token endpoint URL (your backend endpoint that generates CKEditor tokens)
VITE_CKEDITOR_TOKEN_URL=http://localhost:3001/cs-token

# CKEditor Cloud Services WebSocket URL (REQUIRED)
# Get this from your CKEditor Cloud Services dashboard
# Format: wss://your-environment-id.cke-cs.com/ws
VITE_CKEDITOR_WS_URL=wss://your-env-id.cke-cs.com/ws

# CKEditor Cloud Services Environment ID (optional)
VITE_CKEDITOR_ENVIRONMENT_ID=your-env-id

# CKEditor license key (required for premium features: collaboration, comments, AI)
# Get from https://ckeditor.com/ckeditor-5/online-builder/
VITE_CKEDITOR_LICENSE_KEY=your-license-key

# =========================================
# Backend - Supabase Configuration
# =========================================

# Supabase Project URL (same as frontend)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (NEVER expose in frontend, backend only!)
# This bypasses Row Level Security, use carefully
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =========================================
# Backend - CKEditor Configuration
# =========================================

# CKEditor Cloud Services Environment ID
CKEDITOR_ENVIRONMENT_ID=your-env-id

# CKEditor API Secret (NEVER expose in frontend!)
# Used to sign JWT tokens for CKEditor
CKEDITOR_API_SECRET=your-api-secret-here

# =========================================
# Optional Configuration
# =========================================

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Server port
PORT=3001
