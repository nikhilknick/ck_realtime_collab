# CKEditor Cloud Services Configuration
# Copy this file to .env and fill in your actual values. Never commit .env.

# ---- Frontend (Vite) ----
# Token endpoint URL (your backend endpoint that generates CKEditor tokens)
VITE_CKEDITOR_TOKEN_URL=http://localhost:3001/cs-token

# CKEditor Cloud Services WebSocket URL (REQUIRED)
# Get this from your CKEditor Cloud Services dashboard
# Format: wss://your-environment-id.cke-cs.com/ws
VITE_CKEDITOR_WS_URL=

# CKEditor Cloud Services Environment ID (optional, usually included in WS_URL)
VITE_CKEDITOR_ENVIRONMENT_ID=

# CKEditor license key (required for premium features: collaboration, comments, etc.)
# Get from https://ckeditor.com/ckeditor-5/online-builder/
VITE_CKEDITOR_LICENSE_KEY=

# ---- Server (token endpoint) ----
# Development token URL from CKEditor Cloud Services dashboard (dev only; do not use in production)
# Leave empty in production and implement proper token generation.
CKEDITOR_DEV_TOKEN_URL=
